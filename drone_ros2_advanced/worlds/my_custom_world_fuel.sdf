<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  my_custom_world_fuel.sdf  (4주차 - Fuel 모델 배치판)

  my_custom_world.sdf 와 물체 위치는 같고, 직접 만든 도형 대신
  Gazebo Fuel(온라인 모델 저장소)에서 가져온 모델을 놓았습니다.
  → 같은 미션 파일(config/my_custom_world_mission.yaml)로 그대로 비행됩니다.

  ★★ 인터넷이 필요합니다 (첫 1회만) ★★
    Fuel 모델은 첫 실행 때 내려받아 ~/.gz/fuel 에 저장되고,
    그다음부터는 인터넷 없이 실행됩니다.
    **모델 하나라도 못 받으면 월드 전체가 안 뜹니다.**
    그래서 실습 전에 미리 받아두는 것을 권합니다:

      gz fuel download -u "https://fuel.gazebosim.org/1.0/OpenRobotics/models/Table"
      gz fuel download -u "https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier"
      gz fuel download -u "https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree"
      gz fuel download -u "https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone"

    인터넷이 불안하면 로컬 전용인 my_custom_world.sdf 를 쓰세요.

  모델 출처: Table / Jersey Barrier / Pine Tree / Construction Cone
            - 제작 Open Robotics, 라이선스 CC0 1.0 (퍼블릭 도메인)
            - https://app.gazebosim.org/fuel/models
            ※ 다른 모델을 쓸 때는 라이선스를 확인하세요 (CC-BY 모델도 있음)

  설치와 실행:
    cp my_custom_world_fuel.sdf ~/PX4-Autopilot/Tools/simulation/gz/worlds/
    cd ~/PX4-Autopilot
    PX4_GZ_WORLD=my_custom_world_fuel make px4_sitl gz_x500

  ※ 파일 이름과 아래 <world name> 이 같아야 합니다.
  ※ 각 모델의 z 값은 "지면에 놓임(0)"을 가정했습니다. 뜨거나 묻히면
     그 모델의 원점 위치가 다른 것이니 z 만 조정하세요.
  ============================================================================
-->
<sdf version="1.9">
  <world name="my_custom_world_fuel">

    <!-- ===== [복붙 영역] PX4 기본 월드에서 그대로 ===== -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>37.551187</latitude_deg>
      <longitude_deg>127.073880</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- ========================================================
         여기서부터가 "내가 놓는 것" — 4주차 실습 영역
         <pose> 는 x(동) y(북) z(위) roll pitch yaw  ※ ENU
         ======================================================== -->

    <!-- [1] ArUco 마커 — PX4 안에 있는 로컬 모델 (인터넷 불필요)
         동쪽 5m, 북쪽 3m → PX4 좌표로는 (북 3, 동 5) -->
    <include>
      <uri>model://arucotag</uri>
      <name>marker_a</name>
      <pose>5 3 0.001 0 0 0</pose>
    </include>

    <!-- [2] 테이블 — Fuel 모델. 메쉬가 없고 박스·원통뿐이라 가장 가볍다
         상판이 1m 높이라 드론을 그 위에 내려놓을 수도 있다 -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Table</uri>
      <name>table_1</name>
      <pose>-6 0 0 0 0 0</pose>
    </include>

    <!-- [3] 방호벽 — 길이 4m라 화면에서 잘 보이고, 고정(static)이라 안 밀린다
         같은 모델을 두 개 놓을 때는 <name> 을 다르게! -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <name>barrier_1</name>
      <pose>0 9 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <name>barrier_2</name>
      <pose>-5 9 0 0 0 0</pose>
    </include>

    <!-- [4] 소나무 — 잎이 반투명이라 많이 놓으면 느려진다. 5그루 이내 권장 -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <name>tree_1</name>
      <pose>8 -4 0 0 0 0</pose>
    </include>

    <!-- [5] 공사용 콘 — 이 모델만 '고정'이 아니라서 드론이 스치면 넘어진다
         (충돌이 실제로 일어난다는 것을 눈으로 보여주기 좋다) -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <name>cone_1</name>
      <pose>2 -2 0 0 0 0</pose>
    </include>

  </world>
</sdf>
