<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  person_check_world.sdf  (8주차 - 강사 점검용: 거리별 사람 검출 측정)

  수업용 person_world 와 같은 바탕에, 사람이 드론 정면(y = 0) 에서
  3 → 4 → 5 → 6 → 8 m 로 물러나며 각 거리에서 드론 쪽을 보고 10초씩 멈춘다.
  마지막엔 8 m 에서 3 m 로 다가온다(앞모습으로 걷기). 한 바퀴 약 92초(시뮬레이션 시간).
  → w08_person 창 왼쪽 위 글자의 신뢰도·h 비율과 아래 상태줄의 found % 를 거리마다 적어
    기준값·목표 비율을 정한다.

  사진 입간판(Plan B)을 재려면: 아래 actor 블록을 주석 처리하고, 입간판 블록 하나의 주석을 푼다.
    (한 번에 하나만 — 여러 개를 켜면 검출기는 가장 큰 박스 하나만 고른다)

  설치·실행:
    cp person_check_world.sdf ~/PX4-Autopilot/Tools/simulation/gz/worlds/
    cp -r models/* ~/PX4-Autopilot/Tools/simulation/gz/models/
    cd ~/PX4-Autopilot && PX4_GZ_WORLD=person_check_world make px4_sitl gz_x500_mono_cam
  ============================================================================
-->
<sdf version="1.9">
  <world name="person_check_world">

    <!-- ===== 여기부터 ===== PX4 기본 월드에서 그대로 가져온 부분 [복붙 영역]
         (my_custom_world 와 같고, 그림자 두 곳만 false — VM 렌더링 부담을 줄임) -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <!-- ===== 여기까지 ===== [복붙 영역] 끝 -->

    <!-- 시뮬레이션의 GPS 원점 (세종사이버대학교) — my_custom_world 와 같음 -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>37.551187</latitude_deg>
      <longitude_deg>127.073880</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- 거리별 정지 actor: 3·4·5·6·8 m 에서 드론 쪽(yaw 3.14159)을 보고 10초 정지 -->
    <actor name="walker">
      <skin>
        <filename>model://sjcu_walker/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walking">
        <filename>model://sjcu_walker/meshes/walk.dae</filename>
        <scale>1.000000</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.000000</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking" tension="1">
          <!-- 3 m 정지 (앞모습) -->
          <waypoint><time>0.0</time> <pose>3 0 1.0 0 0 3.14159</pose></waypoint>
          <waypoint><time>9.7</time> <pose>3 0 1.0 0 0 3.14159</pose></waypoint>
          <waypoint><time>10.0</time> <pose>3 0 1.0 0 0 3.14159</pose></waypoint>
          <!-- 3 m → 4 m 물러남 (뒷모습) 뒤 4 m 정지 (앞모습) -->
          <waypoint><time>11.5</time> <pose>3 0 1.0 0 0 0</pose></waypoint>
          <waypoint><time>11.8</time> <pose>3 0 1.0 0 0 0</pose></waypoint>
          <waypoint><time>14.4</time> <pose>4 0 1.0 0 0 0</pose></waypoint>
          <waypoint><time>14.7</time> <pose>4 0 1.0 0 0 0</pose></waypoint>
          <waypoint><time>16.2</time> <pose>4 0 1.0 0 0 3.14159</pose></waypoint>
          <waypoint><time>16.5</time> <pose>4 0 1.0 0 0 3.14159</pose></waypoint>
          <waypoint><time>25.9</time> <pose>4 0 1.0 0 0 3.14159</pose></waypoint>
          <waypoint><time>26.2</time> <pose>4 0 1.0 0 0 3.14159</pose></waypoint>
          <!-- 4 m → 5 m 물러남 (뒷모습) 뒤 5 m 정지 (앞모습) -->
          <waypoint><time>27.7</time> <pose>4 0 1.0 0 0 0</pose></waypoint>
          <waypoint><time>28.0</time> <pose>4 0 1.0 0 0 0</pose></waypoint>
          <waypoint><time>30.6</time> <pose>5 0 1.0 0 0 0</pose></waypoint>
          <waypoint><time>30.9</time> <pose>5 0 1.0 0 0 0</pose></waypoint>
          <waypoint><time>32.4</time> <pose>5 0 1.0 0 0 3.14159</pose></waypoint>
          <waypoint><time>32.7</time> <pose>5 0 1.0 0 0 3.14159</pose></waypoint>
          <waypoint><time>42.1</time> <pose>5 0 1.0 0 0 3.14159</pose></waypoint>
          <waypoint><time>42.4</time> <pose>5 0 1.0 0 0 3.14159</pose></waypoint>
          <!-- 5 m → 6 m 물러남 (뒷모습) 뒤 6 m 정지 (앞모습) -->
          <waypoint><time>43.9</time> <pose>5 0 1.0 0 0 0</pose></waypoint>
          <waypoint><time>44.2</time> <pose>5 0 1.0 0 0 0</pose></waypoint>
          <waypoint><time>46.8</time> <pose>6 0 1.0 0 0 0</pose></waypoint>
          <waypoint><time>47.1</time> <pose>6 0 1.0 0 0 0</pose></waypoint>
          <waypoint><time>48.6</time> <pose>6 0 1.0 0 0 3.14159</pose></waypoint>
          <waypoint><time>48.9</time> <pose>6 0 1.0 0 0 3.14159</pose></waypoint>
          <waypoint><time>58.3</time> <pose>6 0 1.0 0 0 3.14159</pose></waypoint>
          <waypoint><time>58.6</time> <pose>6 0 1.0 0 0 3.14159</pose></waypoint>
          <!-- 6 m → 8 m 물러남 (뒷모습) 뒤 8 m 정지 (앞모습) -->
          <waypoint><time>60.1</time> <pose>6 0 1.0 0 0 0</pose></waypoint>
          <waypoint><time>60.4</time> <pose>6 0 1.0 0 0 0</pose></waypoint>
          <waypoint><time>65.8</time> <pose>8 0 1.0 0 0 0</pose></waypoint>
          <waypoint><time>66.1</time> <pose>8 0 1.0 0 0 0</pose></waypoint>
          <waypoint><time>67.6</time> <pose>8 0 1.0 0 0 3.14159</pose></waypoint>
          <waypoint><time>67.9</time> <pose>8 0 1.0 0 0 3.14159</pose></waypoint>
          <waypoint><time>77.3</time> <pose>8 0 1.0 0 0 3.14159</pose></waypoint>
          <waypoint><time>77.6</time> <pose>8 0 1.0 0 0 3.14159</pose></waypoint>
          <!-- 8 m → 3 m 다가옴 (앞모습) — 끝 = 첫 waypoint -->
          <waypoint><time>91.9</time> <pose>3 0 1.0 0 0 3.14159</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- 사진 입간판 (Plan B) — actor 를 주석 처리한 뒤 하나만 주석을 푼다
    <include><uri>model://sjcu_person_board</uri><name>board_3m</name><pose>3 0 0 0 0 0</pose></include>
    -->
    <!--
    <include><uri>model://sjcu_person_board</uri><name>board_5m</name><pose>5 0 0 0 0 0</pose></include>
    -->
    <!--
    <include><uri>model://sjcu_person_board</uri><name>board_8m</name><pose>8 0 0 0 0 0</pose></include>
    -->

  </world>
</sdf>
