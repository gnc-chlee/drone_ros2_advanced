    <!-- ========================================================
         건물 1채 - 주차장 북쪽의 회색 상자 10 × 6 × 8 m   (교수 월드의 building_1 을 옮긴 것, 풍경)
         - <pose>21 23.5 4.0 0 0 0 : z = 높이 8.0 의 절반 → 동쪽 16~26 m, 북쪽 20.5~26.5 m, 높이 0~8 m
         - 코스에서 20 m 넘게 떨어져 있어 비행에는 걸리지 않는다
         - 2D LiDAR(30 m)에는 잡힌다: 왼쪽 섹터가 '자유 공간' 대신 약 20~26 m 로 찍힌다
             (11·12주차와 똑같이 '왼쪽 자유 공간' 으로 두려면 y 를 38 로 - 남쪽 면 북 35 m, 30 m 밖)
         ======================================================== -->
    <model name="building_1">
      <static>true</static>
      <pose>21 23.5 4.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>10 6 8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>10 6 8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

