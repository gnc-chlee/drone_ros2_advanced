    <!-- ========================================================
         칸 번호 판 5개 - 각 칸의 마커와 노란 앞줄 사이 바닥   (이 월드에서 더한 것 - 나머지는 parking_world 와 같음)
         - 판 2.0 × 1.5 m 평면 (동서 2.0 · 남북 1.5), 바닥 윗면보다 2 mm 위 (z 1.2 cm)   ← 마커 판과 같은 방식
         - <pose> x = 12 + 3.5 × N (칸의 동서 가운데), y = 1.65
             → 동 (11.0~13.0) + 3.5 × N, 북 0.9~2.4 m
             마커(북 -0.3~0.3) · 노란 앞줄(북 2.95~3.05) · 주차선(가장 가까운 선까지 0.7 m)과 겹치지 않음
         - 그림: model://sjcu_slot_numbers/materials/textures/number_N.png (1024 × 768 px, 어두운 회색 바탕 + 흰 숫자)
             Gazebo 평면은 그림의 위쪽을 북쪽(+y), 오른쪽을 동쪽(+x)에 붙인다
             → 그림 안의 숫자는 시계 방향으로 90° 누워 있고, 바닥에서는 숫자의 위쪽이 동쪽을 향한다
         - 판 모서리는 둥글다 (반지름 0.6 m 밖은 그림의 투명 부분 → 바닥이 보임)
             네모난 어두운 판은 마커 인식(ArUco)이 마커 후보 사각형으로 읽는다 - 둥근 판은 후보가 되지 않는다
         - roughness 1.0 · metalness 0.0: 번들거리지 않는 페인트처럼
         - 그림만 (<visual>) - 충돌 없음. 2D LiDAR 스캔 평면(땅 위 약 2.3 m)보다 한참 낮아 스캔에 잡히지 않는다
         ======================================================== -->
    <model name="parking_number_0">
      <static>true</static>
      <pose>12.0 1.65 0.012 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2.0 1.5</size>
            </plane>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://sjcu_slot_numbers/materials/textures/number_0.png</albedo_map>
                <roughness>1.0</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>
