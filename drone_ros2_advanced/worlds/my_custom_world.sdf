<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  my_custom_world.sdf  (4주차 - 커스텀 World 시연 시작점)

  PX4 v1.16 내장 aruco.sdf 를 복사해서 만든 실습용 월드입니다.
  마커를 원점이 아닌 곳으로 옮기고, Fuel 모델을 하나만 놓아 두었습니다.
  수업에서는 여기에 <include> 블록을 하나씩 추가하며 배치를 익힙니다.
  (모델을 여러 개 배치한 완성 예시는 my_custom_world_fuel.sdf 참고)

  ★ 가장 중요한 규칙 ★
    파일 이름(my_custom_world.sdf)과 아래 <world name="my_custom_world"> 가
    반드시 같아야 합니다. 다르면 Gazebo 창은 뜨지만 드론이 생기지 않고
    PX4가 "Timed out waiting for Gazebo world" 를 내며 종료합니다.

  ★ <plugin> 을 쓰지 않은 이유 ★
    PX4는 Physics/Imu/NavSat/Sensors 등 13가지 시스템을 server.config 라는
    별도 파일에서 모든 월드에 자동으로 붙여 줍니다.
    그런데 Gazebo는 <world> 바로 아래에 <plugin> 이 하나라도 있으면
    그 자동 적용을 통째로 취소합니다.
    → 일부만 적어두면 나머지가 사라져서 드론이 아예 안 뜹니다.
    → 그래서 이 파일에는 plugin 을 쓰지 않습니다 (PX4 기본 월드들과 동일).

  ★ Fuel 모델은 첫 실행 때 인터넷이 필요합니다 ★
    Table 모델은 처음 한 번만 내려받아 ~/.gz/fuel 에 저장되고,
    그다음부터는 인터넷 없이 실행됩니다.
    **못 받으면 이 모델만 빠지는 게 아니라 월드 전체가 안 뜹니다.**
    실습 전에 미리 받아두세요:
      gz fuel download -u "https://fuel.gazebosim.org/1.0/OpenRobotics/models/Table"

  설치와 실행:
    cp my_custom_world.sdf ~/PX4-Autopilot/Tools/simulation/gz/worlds/
    cd ~/PX4-Autopilot
    PX4_GZ_WORLD=my_custom_world make px4_sitl gz_x500

  좌표 주의 (4주차 핵심):
    Gazebo <pose> 는 ENU = x(동) y(북) z(위)
    PX4  setpoint 는 NED = x(북) y(동) z(아래)
    → 이 파일의 마커 <pose>5 3 …> 은 "동쪽 5m, 북쪽 3m"
    → PX4 좌표로는 (북 3, 동 5) = send_position(3.0, 5.0, -5.0)

  모델 출처: arucotag (PX4 내장) / Table — Open Robotics, CC0 1.0
  ============================================================================
-->
<sdf version="1.9">
  <world name="my_custom_world">

    <!-- ===== 여기부터 ===== PX4 기본 월드에서 그대로 가져온 부분 [복붙 영역] -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <!-- ===== 여기까지 ===== [복붙 영역] 끝 -->

    <!-- 시뮬레이션의 GPS 원점. 여기 숫자를 바꾸면 QGC 지도에서 드론 위치가 바뀝니다.
         (세종사이버대학교) -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>37.551187</latitude_deg>
      <longitude_deg>127.073880</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- ========================================================
         여기서부터가 "내가 놓는 것" — 4주차 실습 영역
         아래 <include> 를 복사해 모델을 하나씩 늘려 보세요.
         ======================================================== -->

    <!-- [1] ArUco 마커 — PX4에 이미 있는 모델을 불러와 위치만 지정
         <pose> 6개 숫자 = x(동) y(북) z(위) roll pitch yaw  ※ ENU
         동쪽 5m, 북쪽 3m 지점의 지면 바로 위(1mm)
         → PX4 좌표로는 북 3, 동 5 : send_position(3.0, 5.0, -고도) -->
    <include>
      <uri>model://arucotag</uri>
      <name>marker_a</name>
      <pose>5 3 0.001 0 0 0</pose>
    </include>

    <!-- [2] 테이블 — Fuel(온라인 카탈로그)에서 가져온 모델
         주소는 모델 페이지의 인용 블록에 있는 url={...} 을 그대로 복사한 것 -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Table</uri>
      <name>table_1</name>          <!-- 같은 모델 여러 개면 이름을 다르게! -->
      <pose>-6 0 0 0 0 0</pose>     <!-- x(동) y(북) z(위) roll pitch yaw -->
    </include>

  </world>
</sdf>
